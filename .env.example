# Copy to .env and fill in. Use a secondary account.
FB_EMAIL=you@example.com
FB_PASSWORD=changeme

# Delays in seconds, "min,max" (random value picked each time)
SCROLL_DELAY=3,7
# Longer break after every BATCH_SIZE posts
BATCH_SIZE=10
BATCH_PAUSE=20,45

# Session cookies file (default cookies.json). `--login` exports it; copy it to a server to log in there.
FB_COOKIES=cookies.json
# 1 = always run without a window (same as --headless)
HEADLESS=0

# Used by `docker compose run --rm scraper`
GROUP_URL=https://www.facebook.com/groups/<test>
POSTS=30
